# Application Settings
APP_NAME="Indian Stock Market Prediction System"
APP_ENV=development
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Kolkata

# Paths (defaults to project data/ and models/ directories if left blank)
APP_DATA_DIR=
APP_MODEL_DIR=
