# ==============================================================================
# Indian Stock Market Prediction System - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local configuration overrides.
# DO NOT commit .env or any file containing actual secrets, passwords, or API keys!
# For production deployments, refer to .env.production.example instead.
# ==============================================================================

# Application Settings
APP_NAME="Indian Stock Market Prediction System"
APP_ENV=development
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Kolkata

# CORS Whitelist (comma-separated origins; defaults to local development ports if left blank)
# In production, explicit HTTPS origins are mandatory (wildcard '*' is forbidden).
# APP_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000

# Paths (defaults to project data/ and models/ directories if left blank)
APP_DATA_DIR=
APP_MODEL_DIR=
DATABASE_PATH=

# LLM Qualitative Reasoning (Local Ollama Instance)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:12b
OLLAMA_TIMEOUT_SECONDS=30.0
