# ==============================================================================
# Indian Stock Market Prediction System - Production Environment Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this template to .env for your production deployment host:
#    cp .env.production.example .env
# 2. Review and update every placeholder to match your production environment.
# 3. DO NOT commit .env or any live credentials/keys to Git!
# ==============================================================================

# Application Environment & Security Controls
APP_NAME="Indian Stock Market Prediction System"
APP_ENV=production
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Kolkata

# Production CORS Whitelist
# MANDATORY: Comma-separated list of explicit HTTPS origins allowed to access the API.
# Wildcard '*' and plain HTTP (non-localhost) origins are strictly rejected at startup.
APP_CORS_ORIGINS=https://trading.yourfirm.in,https://app.yourfirm.in

# Storage Directories
# Set absolute paths to dedicated persistent storage volumes (e.g., SSD mount).
# If left blank, defaults to local project data/ and models/ directories.
APP_DATA_DIR=/var/lib/stock-predictor/data
APP_MODEL_DIR=/var/lib/stock-predictor/models
DATABASE_PATH=/var/lib/stock-predictor/data/predictions.db

# Qualitative LLM Inference (Local Ollama Instance)
# Assumes Ollama is running on localhost or isolated internal network without WAN exposure.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:12b
OLLAMA_TIMEOUT_SECONDS=30.0
